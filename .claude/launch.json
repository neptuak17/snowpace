{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8091", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 8091
    }
  ]
}
